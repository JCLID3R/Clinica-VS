# Copiar este archivo como .env y completar los valores (el .env NO se sube a GitHub)
# desarrollo = muestra detalles de errores | produccion = cookies seguras (HTTPS) y errores genéricos
APP_ENTORNO=desarrollo

# ---- Conexión a PostgreSQL LOCAL (tu PC) ----------------------------------------
DB_HOST=127.0.0.1
DB_PUERTO=5432
DB_NOMBRE=clinica_vida_salud
DB_USUARIO=postgres
DB_CLAVE=tu_clave_de_postgres
DB_SSLMODE=

# ---- Conexión a SUPABASE (nube) — usar el "Session pooler" -------------------------
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PUERTO=5432
# DB_NOMBRE=postgres
# DB_USUARIO=postgres.<id-de-tu-proyecto>
# DB_CLAVE=<contraseña de la base en Supabase>
# DB_SSLMODE=require

# Orígenes del frontend permitidos (CORS), separados por coma.
# Solo es necesario si el frontend corre en otro puerto (php -S o Live Server).
FRONTEND_ORIGENES=http://localhost:5500,http://127.0.0.1:5500

# ---- CU01: inicio ----
# Correo con la API HTTP de Brevo (Render bloquea SMTP). Clave en Brevo: SMTP & API -> API Keys.
# Si MAIL_API_KEY queda vacío y APP_ENTORNO=desarrollo, el correo se escribe en el log de errores de PHP.
MAIL_API_KEY=
MAIL_REMITENTE=correo_verificado_en_brevo@ejemplo.com
MAIL_REMITENTE_NOMBRE=Clínica Vida Salud
# ---- CU01: fin ----
