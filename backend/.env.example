# Copiar este archivo como .env y completar los valores (el .env NO se sube a GitHub)
APP_ENTORNO=desarrollo

# Conexión a PostgreSQL
DB_HOST=127.0.0.1
DB_PUERTO=5432
DB_NOMBRE=clinica_vida_salud
DB_USUARIO=postgres
DB_CLAVE=tu_clave_de_postgres

# Orígenes del frontend permitidos (CORS), separados por coma.
# Solo es necesario si el frontend corre en otro puerto (php -S o Live Server).
FRONTEND_ORIGENES=http://localhost:5500,http://127.0.0.1:5500
